.env
.env.*
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
logs/
# data/* rather than data/ so the negation below can take effect: git will
# not re-include a file whose parent DIRECTORY is excluded.
data/*
# ...except the verse corpus: public-domain texts (epics, kāvya, prakaraṇa
# works), and without it a fresh clone cannot recite. The phrasebook stays
# ignored — that one is copyrighted (see lexicon/phrasebook.py).
!data/shlokas.json
models/*.onnx
sim_frame.jpg
clips/
data/daily.pdf
__pycache__/
*.pyc
